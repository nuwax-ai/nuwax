# deploy_sync_test.sh 配置模板
#
# 使用：复制为本目录下的 deploy_sync_test.env 后按需修改（真实配置已 gitignore，仅本机生效）：
#   cp scripts/deploy_sync_test.env.example scripts/deploy_sync_test.env
# 也可不复制，直接终端运行 bash scripts/deploy_sync_test.sh 走首次交互式配置。
# 优先级：环境变量 > deploy_sync_test.env > 交互提示/内置默认。

# 个人开发分支（必填，无默认值）
FEATURE_BRANCH=feat-dong.0930
# 团队版本开发分支（必填，无默认值；注意历史命名无前导零，如 feat-2026.9.30）
VERSION_BRANCH=feat-2026.9.30
# 集成分支（选填，默认 dev；仅本地合并作为部署数据源，不推送远端）
DEV_BRANCH=dev
# 测试部署分支（选填，默认 test）
TEST_BRANCH=test
