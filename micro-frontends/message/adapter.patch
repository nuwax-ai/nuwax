new file mode 100644
index 0000000..8b1cf77
--- /dev/null
+++ b/nuwax-im-web/src/lib/conversationTasksController.ts
@@ -0,0 +1,204 @@
+import {
+  assertTaskPage,
+  mergeTaskRecords,
+  tasksErrorMessage,
+  type ConversationTask,
+  type ConversationTasksProvider,
+  type TaskArtifact,
+} from './conversationTasks';
+
+export interface TaskLoadState<T> {
+  records: T[];
+  loading: boolean;
+  loaded: boolean;
+  error?: string;
+  hasMore: boolean;
+  nextCursor?: string;
+}
+
+export interface ConversationTasksState {
+  conversationId: string | null;
+  tasks: TaskLoadState<ConversationTask>;
+  artifacts: Record<string, TaskLoadState<TaskArtifact>>;
+}
+
+const emptyLoad = <T>(): TaskLoadState<T> => ({
+  records: [],
+  loading: false,
+  loaded: false,
+  hasMore: false,
+});
+
+/** 面板自己的请求状态，不污染消息 store；代次同时防切会话、ABA 与卸载的迟到响应。 */
+export class ConversationTasksController {
+  private state: ConversationTasksState = {
+    conversationId: null,
+    tasks: emptyLoad(),
+    artifacts: {},
+  };
+  private listeners = new Set<() => void>();
+  private generation = 0;
+  private taskRequest = 0;
+  private artifactRequest = 0;
+  private artifactRequests = new Map<string, number>();
+
+  constructor(private readonly provider: ConversationTasksProvider) {}
+
+  getSnapshot = (): ConversationTasksState => this.state;
+  subscribe = (listener: () => void): (() => void) => {
+    this.listeners.add(listener);
+    return () => this.listeners.delete(listener);
+  };
+
+  private update(state: ConversationTasksState): void {
+    this.state = state;
+    this.listeners.forEach((listener) => listener());
+  }
+
+  selectConversation(conversationId: string | null): void {
+    this.generation += 1;
+    this.artifactRequests.clear();
+    this.update({ conversationId, tasks: emptyLoad(), artifacts: {} });
+    if (conversationId) void this.loadTasks();
+  }
+
+  deactivate(): void {
+    this.generation += 1;
+    this.artifactRequests.clear();
+  }
+
+  async loadTasks(more = false): Promise<void> {
+    const conversationId = this.state.conversationId;
+    const previous = this.state.tasks;
+    if (!conversationId || (more && (previous.loading || !previous.hasMore)))
+      return;
+    const generation = this.generation;
+    const request = ++this.taskRequest;
+    const cursor = more ? previous.nextCursor : undefined;
+    const current = () =>
+      generation === this.generation && request === this.taskRequest;
+    this.update({
+      ...this.state,
+      tasks: { ...previous, loading: true, error: undefined },
+    });
+    try {
+      const page = await this.provider.listTasks({
+        imConversationId: conversationId,
+        cursor,
+      });
+      assertTaskPage(page, cursor);
+      if (!current()) return;
+      // 即使 adapter 出错，也不能把另一会话的内容渲染到当前会话。
+      if (
+        page.records.some((task) => task.imConversationId !== conversationId)
+      ) {
+        throw new Error('任务关联会话不一致');
+      }
+      const records = mergeTaskRecords(
+        more ? previous.records : [],
+        page.records,
+        (task) => task.key,
+      );
+      const keys = new Set(records.map((task) => task.key));
+      const previousTasks = new Map(
+        previous.records.map((task) => [task.key, task]),
+      );
+      const changedKeys = new Set(
+        records
+          .filter((task) => {
+            const before = previousTasks.get(task.key);
+            return (
+              before &&
+              (before.taskId !== task.taskId ||
+                before.updatedAt !== task.updatedAt ||
+                before.artifactCount !== task.artifactCount ||
+                before.taskStatus !== task.taskStatus)
+            );
+          })
+          .map((task) => task.key),
+      );
+      // 刷新删除的任务不能留下产物，也不能接受其仍在途中的产物请求。
+      this.artifactRequests.forEach((_request, key) => {
+        if (!keys.has(key) || changedKeys.has(key))
+          this.artifactRequests.delete(key);
+      });
+      this.update({
+        ...this.state,
+        artifacts: Object.fromEntries(
+          Object.entries(this.state.artifacts).filter(
+            ([key]) => keys.has(key) && !changedKeys.has(key),
+          ),
+        ),
+        tasks: {
+          records,
+          loading: false,
+          loaded: true,
+          hasMore: page.hasMore,
+          nextCursor: page.nextCursor,
+        },
+      });
+    } catch (error) {
+      if (current())
+        this.update({
+          ...this.state,
+          tasks: {
+            ...previous,
+            loading: false,
+            error: tasksErrorMessage(error),
+          },
+        });
+    }
+  }
+
+  async loadArtifacts(taskKey: string, more = false): Promise<void> {
+    const conversationId = this.state.conversationId;
+    if (
+      !conversationId ||
+      !this.state.tasks.records.some((task) => task.key === taskKey)
+    )
+      return;
+    const previous = this.state.artifacts[taskKey] ?? emptyLoad<TaskArtifact>();
+    if (more && (previous.loading || !previous.hasMore)) return;
+    const generation = this.generation;
+    // 全局递增而非每 key 从 1 重来，防刷新移除→恢复同一任务的 ABA 迟到响应。
+    const request = ++this.artifactRequest;
+    this.artifactRequests.set(taskKey, request);
+    const cursor = more ? previous.nextCursor : undefined;
+    const current = () =>
+      generation === this.generation &&
+      this.artifactRequests.get(taskKey) === request;
+    const setArtifacts = (load: TaskLoadState<TaskArtifact>) =>
+      this.update({
+        ...this.state,
+        artifacts: { ...this.state.artifacts, [taskKey]: load },
+      });
+    setArtifacts({ ...previous, loading: true, error: undefined });
+    try {
+      const page = await this.provider.listArtifacts({
+        imConversationId: conversationId,
+        taskKey,
+        cursor,
+      });
+      assertTaskPage(page, cursor);
+      if (current())
+        setArtifacts({
+          records: mergeTaskRecords(
+            more ? previous.records : [],
+            page.records,
+            (artifact) => artifact.id,
+          ),
+          loaded: true,
+          loading: false,
+          hasMore: page.hasMore,
+          nextCursor: page.nextCursor,
+        });
+    } catch (error) {
+      if (current())
+        setArtifacts({
+          ...previous,
+          loading: false,
+          error: tasksErrorMessage(error),
+        });
+    }
+  }
+}
