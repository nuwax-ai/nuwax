diff --git a/nuwax-im-web/src/dev/conversationTasksMock.ts b/nuwax-im-web/src/dev/conversationTasksMock.ts
new file mode 100644
index 0000000..f3365d9
--- /dev/null
+++ b/nuwax-im-web/src/dev/conversationTasksMock.ts
@@ -0,0 +1,254 @@
+import {
+  TasksError,
+  type ConversationTask,
+  type ConversationTasksProvider,
+  type TaskArtifact,
+  type TaskArtifactResource,
+} from '../lib/conversationTasks';
+
+export type TasksMockScenario =
+  | 'overview'
+  | 'empty'
+  | 'error'
+  | 'forbidden'
+  | 'artifact-error'
+  | 'edge-cases'
+  | 'resource-error';
+export const TASKS_MOCK_SCENARIOS: readonly TasksMockScenario[] = [
+  'overview',
+  'empty',
+  'error',
+  'forbidden',
+  'artifact-error',
+  'edge-cases',
+  'resource-error',
+];
+
+export function tasksMockScenario(raw: string | null): TasksMockScenario {
+  return (
+    TASKS_MOCK_SCENARIOS.find((scenario) => scenario === raw) ?? 'overview'
+  );
+}
+
+const FIXTURE_TIME = '2026-10-02T04:00:00Z';
+const LONG_NAME =
+  '0930版本交付验收报告_包含会话任务产物展示和成员可见范围的长文件名用于检查窄面板自动换行_0123456789abcdefghijklmnopqrstuvwxyz.txt';
+
+/** 仅临时演示数据，不能作为后端成员授权的实现或真实执行历史。 */
+function tasksFor(
+  conversationId: string,
+  scenario?: TasksMockScenario,
+): ConversationTask[] {
+  const make = (
+    index: number,
+    title: string,
+    taskStatus: string,
+    artifactCount: number,
+  ): ConversationTask => ({
+    key: `${conversationId}-platform-${index}`,
+    imConversationId: conversationId,
+    platformConversationId: `${conversationId}000${index}`,
+    taskId: `demo-${conversationId}-${index}`,
+    agentSubjectId: `demo-agent-subject-${index}`,
+    agentId: `demo-agent-${index}`,
+    agentName: index === 1 ? '交付助手' : '资料整理助手',
+    title,
+    taskStatus,
+    artifactCount,
+    updatedAt: FIXTURE_TIME,
+  });
+  if (conversationId === '1001') {
+    const records = [
+      make(1, '0930 版本交付验收报告', 'COMPLETE', 3),
+      make(
+        2,
+        '任务与产物_超长标题验证abcdefghijklmnopqrstuvwxyz0123456789_会话关联女娲任务展示',
+        'EXECUTING',
+        0,
+      ),
+      make(3, '等待生成资料摘要', 'CREATE', 0),
+      make(4, '数据核对失败（保留已有产物）', 'FAILED', 1),
+      make(5, '已取消的整理任务', 'CANCEL', 0),
+    ];
+    if (scenario === 'edge-cases')
+      records.push({
+        ...make(6, '', 'UNRECOGNIZED', 2),
+        agentName: undefined,
+        updatedAt: undefined,
+      });
+    return records;
+  }
+  if (conversationId === '1002')
+    return [make(1, '张三的资料摘要', 'COMPLETE', 1)];
+  if (conversationId === '1003')
+    return [make(1, '开发者小助手正在整理资料', 'EXECUTING', 0)];
+  return [];
+}
+
+const availableArtifact = (
+  id: string,
+  name: string,
+  mimeType = 'text/plain',
+): TaskArtifact => ({
+  id,
+  name,
+  mimeType,
+  availability: 'available',
+});
+
+function artifactsFor(conversationId: string, taskKey: string): TaskArtifact[] {
+  if (taskKey === '1001-platform-6')
+    return [
+      {
+        ...availableArtifact(
+          'binary',
+          '边界下载示例.dat',
+          'application/octet-stream',
+        ),
+        size: 4,
+        description: '固定四字节二进制，仅用于核对下载内容。',
+      },
+      {
+        ...availableArtifact('svg', '仅下载的矢量示例.svg', 'image/svg+xml'),
+        description: '此图片格式不进入预览，返回列表可显式下载。',
+      },
+    ];
+  if (taskKey === '1001-platform-1')
+    return [
+      {
+        ...availableArtifact('report', LONG_NAME),
+        description: '前端验收摘要；点击查看内容或下载。',
+      },
+      {
+        ...availableArtifact('image', '任务产物示例.png', 'image/png'),
+        description: '本地示例图片，不读取平台文件。',
+      },
+      {
+        id: 'expired',
+        name: '已失效的历史附件.pdf',
+        mimeType: 'application/pdf',
+        availability: 'unavailable',
+        unavailableReason: '产物暂不可用',
+      },
+    ];
+  if (taskKey === '1001-platform-4')
+    return [availableArtifact('partial', '执行失败前已生成的检查记录.txt')];
+  if (conversationId === '1002' && taskKey === '1002-platform-1')
+    return [availableArtifact('summary', '张三的摘要.txt')];
+  return [];
+}
+
+/** fixture 内使用固定的 PNG 字节；避免外部图片地址污染离线预览。 */
+const DEMO_PNG =
+  '';
+
+function imageResource(): TaskArtifactResource {
+  const bytes = Uint8Array.from(atob(DEMO_PNG), (character) =>
+    character.charCodeAt(0),
+  );
+  return { kind: 'image', blob: new Blob([bytes], { type: 'image/png' }) };
+}
+
+export function createTasksMockProvider(
+  scenario: TasksMockScenario = 'overview',
+  delayMs = 220,
+): ConversationTasksProvider {
+  const failedLists = new Set<string>();
+  const failedArtifacts = new Set<string>();
+  const failedResources = new Set<string>();
+  const pause = () =>
+    new Promise<void>((resolve) => setTimeout(resolve, delayMs));
+  return {
+    available: true,
+    mode: 'mock',
+    async listTasks({ imConversationId }) {
+      // 在异步等待前固定本批请求的错误，StrictMode 并发首屏不能提前耗掉故障。
+      const failInitialList =
+        scenario === 'error' && !failedLists.has(imConversationId);
+      await pause();
+      if (scenario === 'forbidden') throw new TasksError('forbidden');
+      if (failInitialList) {
+        failedLists.add(imConversationId);
+        throw new TasksError('network');
+      }
+      return {
+        records:
+          scenario === 'empty' ? [] : tasksFor(imConversationId, scenario),
+        hasMore: false,
+      };
+    },
+    async listArtifacts({ imConversationId, taskKey }) {
+      await pause();
+      if (scenario === 'forbidden') throw new TasksError('forbidden');
+      if (
+        !tasksFor(imConversationId, scenario).some(
+          (task) => task.key === taskKey,
+        )
+      )
+        throw new TasksError('not-found');
+      if (
+        scenario === 'artifact-error' &&
+        taskKey.endsWith('-1') &&
+        !failedArtifacts.has(taskKey)
+      ) {
+        failedArtifacts.add(taskKey);
+        throw new TasksError('network', '产物加载失败，请重试');
+      }
+      return {
+        records: artifactsFor(imConversationId, taskKey),
+        hasMore: false,
+      };
+    },
+    async readArtifact({ imConversationId, taskKey, artifactId }) {
+      await pause();
+      if (scenario === 'forbidden') throw new TasksError('forbidden');
+      if (
+        !tasksFor(imConversationId, scenario).some(
+          (task) => task.key === taskKey,
+        )
+      )
+        throw new TasksError('not-found');
+      const artifact = artifactsFor(imConversationId, taskKey).find(
+        (item) => item.id === artifactId,
+      );
+      if (!artifact || artifact.availability !== 'available')
+        throw new TasksError('not-found');
+      // 仅显式开发场景注入一次读取失败；同一会话/任务/产物重试可恢复。
+      const resourceKey = `${imConversationId}:${taskKey}:${artifactId}`;
+      if (scenario === 'resource-error' && !failedResources.has(resourceKey)) {
+        failedResources.add(resourceKey);
+        throw new TasksError('network', '产物读取失败，请重试');
+      }
+      if (artifact.id === 'binary')
+        return {
+          kind: 'file',
+          blob: new Blob([Uint8Array.of(0x00, 0x41, 0xff, 0x10)], {
+            type: 'application/octet-stream',
+          }),
+        };
+      if (artifact.id === 'svg')
+        return {
+          kind: 'image',
+          blob: new Blob(
+            [
+              '<svg xmlns="http://www.w3.org/2000/svg" width="40" height="40"><rect width="40" height="40" fill="#3370ff"/></svg>',
+            ],
+            { type: 'image/svg+xml' },
+          ),
+        };
+      if (artifact.id === 'image') return imageResource();
+      return {
+        kind: 'text',
+        mimeType: 'text/plain',
+        text: [
+          artifact.name,
+          '',
+          `关联 IM 会话：${imConversationId}`,
+          '这是一份本地演示产物，用于核对任务列表、内容预览和下载。',
+          '正式任务与产物由后端按当前成员身份授权返回。',
+          '<script>这段文本会按原样展示，不会执行。</script>',
+        ].join('\n'),
+      };
+    },
+  };
+}
