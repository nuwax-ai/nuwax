@@ -0,0 +1,453 @@
+import { Alert, Button, Empty, Modal, Spin, Tag } from 'antd';
+import {
+  useEffect,
+  useMemo,
+  useRef,
+  useState,
+  useSyncExternalStore,
+} from 'react';
+import type { Id } from '../api/types';
+import { formatSize } from '../api/upload';
+import {
+  canPreviewTaskImage,
+  TasksError,
+  tasksErrorMessage,
+  taskStatusLabel,
+  taskTitle,
+  type ConversationTask,
+  type ConversationTasksProvider,
+  type TaskArtifact,
+  type TaskArtifactResource,
+} from '../lib/conversationTasks';
+import {
+  ConversationTasksController,
+  type TaskLoadState,
+} from '../lib/conversationTasksController';
+import './ChatTasksPanel.css';
+import PanelCloseButton from './PanelCloseButton';
+
+function taskTime(value?: string): string {
+  const date = value ? new Date(value) : undefined;
+  return date && Number.isFinite(date.getTime())
+    ? date.toLocaleString('zh-CN', { hour12: false })
+    : '更新时间未知';
+}
+
+function ErrorNotice({
+  error,
+  loading,
+  onRetry,
+}: {
+  error?: string;
+  loading: boolean;
+  onRetry: () => void;
+}) {
+  return error ? (
+    <Alert
+      type="error"
+      showIcon
+      message={error}
+      action={
+        <Button size="small" loading={loading} onClick={onRetry}>
+          重试
+        </Button>
+      }
+    />
+  ) : null;
+}
+
+/** 全部资源来自 provider 授权读取的内容/Blob；这里没有任意 URL 跳转或 HTML 执行路径。 */
+function ArtifactPreview({
+  name,
+  resource,
+  onClose,
+}: {
+  name: string;
+  resource: TaskArtifactResource;
+  onClose: () => void;
+}) {
+  const [imageUrl, setImageUrl] = useState<string>();
+  useEffect(() => {
+    if (!canPreviewTaskImage(resource) || resource.kind === 'text') return;
+    const url = URL.createObjectURL(resource.blob);
+    setImageUrl(url);
+    return () => URL.revokeObjectURL(url);
+  }, [resource]);
+  return (
+    <Modal
+      open
+      title={name}
+      footer={null}
+      onCancel={onClose}
+      getContainer={false}
+      width={640}
+      className="task-artifact-preview"
+    >
+      {resource.kind === 'text' ? (
+        <pre>{resource.text}</pre>
+      ) : canPreviewTaskImage(resource) ? (
+        <img src={imageUrl} alt={name} />
+      ) : (
+        <p>暂不支持预览此文件，可返回列表下载。</p>
+      )}
+    </Modal>
+  );
+}
+
+function downloadArtifact(resource: TaskArtifactResource, name: string): void {
+  const blob =
+    resource.kind === 'text'
+      ? new Blob([resource.text], {
+          type: resource.mimeType || 'text/plain;charset=utf-8',
+        })
+      : resource.blob;
+  const url = URL.createObjectURL(blob);
+  const anchor = document.createElement('a');
+  anchor.href = url;
+  // 只作为下载文件名，不能变成路径；下载结束后回收临时 URL。
+  anchor.download = name.replace(/[\\/\x00-\x1f]/g, '_') || '任务产物';
+  document.body.appendChild(anchor);
+  try {
+    anchor.click();
+  } finally {
+    anchor.remove();
+    setTimeout(() => URL.revokeObjectURL(url), 1000);
+  }
+}
+
+function ArtifactList({
+  task,
+  load,
+  onLoad,
+  onRead,
+  busy,
+}: {
+  task: ConversationTask;
+  load?: TaskLoadState<TaskArtifact>;
+  onLoad: (more?: boolean) => void;
+  onRead: (artifact: TaskArtifact, download: boolean) => void;
+  busy: boolean;
+}) {
+  return (
+    <div className="task-artifacts">
+      {load?.loaded && (
+        <Button size="small" loading={load.loading} onClick={() => onLoad()}>
+          刷新产物
+        </Button>
+      )}
+      <ErrorNotice
+        error={load?.error}
+        loading={!!load?.loading}
+        onRetry={() => onLoad()}
+      />
+      {load?.loading && (
+        <div className="task-artifact-loading">
+          <Spin size="small" /> 正在加载产物…
+        </div>
+      )}
+      {load?.loaded && !load.records.length && !load.error && (
+        <p className="task-muted">
+          {task.taskStatus === 'EXECUTING'
+            ? '任务执行中，暂无产物'
+            : '暂无产物'}
+        </p>
+      )}
+      {!!load?.records.length && (
+        <ul className="task-artifact-list">
+          {load.records.map((artifact) => (
+            <li key={artifact.id}>
+              <div className="task-artifact-name">
+                {artifact.name.trim() || '未命名产物'}
+              </div>
+              {artifact.description && (
+                <p className="task-muted">{artifact.description}</p>
+              )}
+              <div className="task-muted">
+                {artifact.mimeType || '文件类型未知'} ·{' '}
+                {typeof artifact.size === 'number' && artifact.size >= 0
+                  ? formatSize(artifact.size)
+                  : '大小未知'}
+              </div>
+              {artifact.availability === 'available' ? (
+                <div className="task-artifact-actions">
+                  <Button
+                    size="small"
+                    disabled={busy}
+                    onClick={() => onRead(artifact, false)}
+                  >
+                    查看
+                  </Button>
+                  <Button
+                    size="small"
+                    disabled={busy}
+                    onClick={() => onRead(artifact, true)}
+                  >
+                    下载
+                  </Button>
+                </div>
+              ) : (
+                <p className="task-muted">
+                  {artifact.unavailableReason || '产物暂不可用'}
+                </p>
+              )}
+            </li>
+          ))}
+        </ul>
+      )}
+      {load?.hasMore && (
+        <Button
+          size="small"
+          loading={load.loading}
+          onClick={() => onLoad(true)}
+        >
+          加载更多产物
+        </Button>
+      )}
+    </div>
+  );
+}
+
+/** 只读任务面板；请求状态只属于当前会话，关闭或切会话即失效。 */
+export default function ChatTasksPanel({
+  convId,
+  provider,
+  onClose,
+}: {
+  convId: Id | null;
+  provider: ConversationTasksProvider;
+  onClose: () => void;
+}) {
+  const controller = useMemo(
+    () => new ConversationTasksController(provider),
+    [provider],
+  );
+  const state = useSyncExternalStore(
+    controller.subscribe,
+    controller.getSnapshot,
+  );
+  const [expanded, setExpanded] = useState<Set<string>>(() => new Set());
+  const [preview, setPreview] = useState<{
+    taskKey: string;
+    taskId?: string;
+    name: string;
+    resource: TaskArtifactResource;
+  }>();
+  const [resourceError, setResourceError] = useState<{
+    taskKey: string;
+    message: string;
+  }>();
+  const [readingTask, setReadingTask] = useState<string>();
+  const reading = !!readingTask;
+  const resourceRequest = useRef(0);
+  const conversationId = convId == null ? null : String(convId);
+  useEffect(() => {
+    controller.selectConversation(conversationId);
+    setExpanded(new Set());
+    setPreview(undefined);
+    setResourceError(undefined);
+    setReadingTask(undefined);
+    return () => {
+      controller.deactivate();
+      resourceRequest.current += 1;
+    };
+  }, [controller, conversationId]);
+
+  useEffect(() => {
+    if (
+      preview &&
+      !state.tasks.records.some(
+        (task) =>
+          task.key === preview.taskKey && task.taskId === preview.taskId,
+      )
+    )
+      setPreview(undefined);
+  }, [state.tasks.records, preview]);
+
+  // 刷新后同一平台会话换了当前任务/产物状态，已展开项按新记录重新读取。
+  useEffect(() => {
+    if (state.conversationId !== conversationId) return;
+    expanded.forEach((key) => {
+      if (
+        state.tasks.records.some((task) => task.key === key) &&
+        !state.artifacts[key]
+      )
+        void controller.loadArtifacts(key);
+    });
+  }, [controller, state, conversationId, expanded]);
+
+  const readArtifact = async (
+    task: ConversationTask,
+    artifact: TaskArtifact,
+    download: boolean,
+  ) => {
+    if (!conversationId || reading) return;
+    const request = ++resourceRequest.current;
+    setReadingTask(task.key);
+    setResourceError(undefined);
+    try {
+      const resource = await provider.readArtifact({
+        imConversationId: conversationId,
+        taskKey: task.key,
+        artifactId: artifact.id,
+      });
+      if (request !== resourceRequest.current) return;
+      if (
+        !controller
+          .getSnapshot()
+          .tasks.records.some(
+            (item) => item.key === task.key && item.taskId === task.taskId,
+          )
+      )
+        throw new TasksError('not-found');
+      if (download) downloadArtifact(resource, artifact.name);
+      else
+        setPreview({
+          taskKey: task.key,
+          taskId: task.taskId,
+          name: artifact.name,
+          resource,
+        });
+    } catch (error) {
+      if (request === resourceRequest.current)
+        setResourceError({
+          taskKey: task.key,
+          message: tasksErrorMessage(error),
+        });
+    } finally {
+      if (request === resourceRequest.current) setReadingTask(undefined);
+    }
+  };
+
+  // key={convId} 的调用约定防止旧会话在新 props 下短暂露出；此处也做防御。
+  const tasks =
+    state.conversationId === conversationId ? state.tasks : undefined;
+  return (
+    <section className="chat-panel chat-tasks-panel" aria-label="会话关联任务">
+      <div className="chat-panel-head">
+        <span className="chat-panel-title">任务</span>
+        <div className="chat-panel-head-end">
+          <Button
+            size="small"
+            loading={tasks?.loading}
+            onClick={() => void controller.loadTasks()}
+          >
+            刷新
+          </Button>
+          <PanelCloseButton panel="任务" onClose={onClose} />
+        </div>
+      </div>
+      <div className="chat-panel-scroll">
+        {provider.mode === 'mock' && (
+          <p className="task-muted task-mock-note">本地演示数据</p>
+        )}
+        {!provider.available ? (
+          <Alert type="info" message="任务服务尚未接入" />
+        ) : (
+          <>
+            <ErrorNotice
+              error={tasks?.error}
+              loading={!!tasks?.loading}
+              onRetry={() => void controller.loadTasks()}
+            />
+            {tasks?.loading && (
+              <div className="task-artifact-loading">
+                <Spin size="small" /> 正在加载任务…
+              </div>
+            )}
+            {tasks?.loaded && !tasks.records.length && !tasks.error && (
+              <Empty
+                image={Empty.PRESENTED_IMAGE_SIMPLE}
+                description="暂无关联任务"
+              />
+            )}
+            {!!tasks?.records.length && (
+              <ul className="conversation-task-list">
+                {tasks.records.map((task) => {
+                  const open = expanded.has(task.key);
+                  return (
+                    <li key={task.key} className="conversation-task-item">
+                      <h3>{taskTitle(task)}</h3>
+                      <div className="task-meta">
+                        <Tag>{taskStatusLabel(task.taskStatus)}</Tag>
+                        <span>{task.agentName?.trim() || '未知智能体'}</span>
+                      </div>
+                      <p className="task-muted">{taskTime(task.updatedAt)}</p>
+                      <Button
+                        className="task-expand"
+                        size="small"
+                        aria-expanded={open}
+                        onClick={() => {
+                          setExpanded((current) => {
+                            const next = new Set(current);
+                            if (open) next.delete(task.key);
+                            else next.add(task.key);
+                            return next;
+                          });
+                          if (
+                            !open &&
+                            !state.artifacts[task.key]?.loaded &&
+                            !state.artifacts[task.key]?.loading
+                          )
+                            void controller.loadArtifacts(task.key);
+                        }}
+                      >
+                        {open
+                          ? '收起产物'
+                          : `查看产物${
+                              typeof task.artifactCount === 'number' &&
+                              task.artifactCount >= 0
+                                ? `（${task.artifactCount}）`
+                                : ''
+                            }`}
+                      </Button>
+                      {open && (
+                        <ArtifactList
+                          task={task}
+                          load={state.artifacts[task.key]}
+                          onLoad={(more) =>
+                            void controller.loadArtifacts(task.key, more)
+                          }
+                          onRead={(artifact, download) =>
+                            void readArtifact(task, artifact, download)
+                          }
+                          busy={reading}
+                        />
+                      )}
+                      {readingTask === task.key && (
+                        <p className="task-muted" role="status">
+                          正在读取产物…
+                        </p>
+                      )}
+                      {resourceError?.taskKey === task.key && (
+                        <Alert
+                          type="error"
+                          showIcon
+                          message={resourceError.message}
+                        />
+                      )}
+                    </li>
+                  );
+                })}
+              </ul>
+            )}
+            {tasks?.hasMore && (
+              <Button
+                loading={tasks.loading}
+                onClick={() => void controller.loadTasks(true)}
+              >
+                加载更多任务
+              </Button>
+            )}
+          </>
+        )}
+      </div>
+      {preview && (
+        <ArtifactPreview
+          name={preview.name}
+          resource={preview.resource}
+          onClose={() => setPreview(undefined)}
+        />
+      )}
+    </section>
+  );
+}
