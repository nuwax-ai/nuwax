+/** IM 关联女娲任务的前端投影；真实接口尚待对齐，不能混用 IM/平台会话 ID。 */
+export type PlatformTaskStatus =
+  | 'CREATE'
+  | 'EXECUTING'
+  | 'COMPLETE'
+  | 'FAILED'
+  | 'CANCEL';
+
+export interface ConversationTask {
+  key: string;
+  imConversationId: string;
+  platformConversationId: string;
+  agentSubjectId: string;
+  agentId: string;
+  agentName?: string;
+  title?: string;
+  taskId?: string;
+  taskStatus?: PlatformTaskStatus | string;
+  updatedAt?: string;
+  artifactCount?: number;
+}
+
+export interface TaskArtifact {
+  id: string;
+  name: string;
+  description?: string;
+  mimeType?: string;
+  size?: number;
+  availability: 'available' | 'unavailable';
+  unavailableReason?: string;
+}
+
+export interface TaskPage<T> {
+  records: T[];
+  hasMore: boolean;
+  nextCursor?: string;
+}
+
+/** 资源在明确点击时才读取；二进制由 provider 授权获取为 Blob，不接受任意跳转 URL。 */
+export type TaskArtifactResource =
+  | { kind: 'text'; text: string; mimeType?: string }
+  | { kind: 'image' | 'file'; blob: Blob };
+
+export interface ConversationTasksProvider {
+  readonly available: boolean;
+  readonly mode: 'mock' | 'live' | 'unavailable';
+  listTasks(input: {
+    imConversationId: string;
+    cursor?: string;
+  }): Promise<TaskPage<ConversationTask>>;
+  listArtifacts(input: {
+    imConversationId: string;
+    taskKey: string;
+    cursor?: string;
+  }): Promise<TaskPage<TaskArtifact>>;
+  readArtifact(input: {
+    imConversationId: string;
+    taskKey: string;
+    artifactId: string;
+  }): Promise<TaskArtifactResource>;
+}
+
+export type TasksErrorCode =
+  | 'unauthenticated'
+  | 'forbidden'
+  | 'unavailable'
+  | 'network'
+  | 'not-found';
+
+export class TasksError extends Error {
+  constructor(public readonly code: TasksErrorCode, message?: string) {
+    super(message ?? tasksErrorLabel(code));
+    this.name = 'TasksError';
+  }
+}
+
+export function tasksErrorLabel(code: TasksErrorCode): string {
+  switch (code) {
+    case 'unauthenticated':
+      return '登录已失效，请重新登录';
+    case 'forbidden':
+      return '暂无权限查看';
+    case 'unavailable':
+      return '任务服务尚未接入';
+    case 'not-found':
+      return '任务或产物已不存在';
+    default:
+      return '加载失败，请重试';
+  }
+}
+
+export function tasksErrorMessage(error: unknown): string {
+  return error instanceof TasksError
+    ? error.message
+    : tasksErrorLabel('network');
+}
+
+export function taskStatusLabel(status?: string): string {
+  switch (status) {
+    case 'CREATE':
+      return '待开始';
+    case 'EXECUTING':
+      return '执行中';
+    case 'COMPLETE':
+      return '已完成';
+    case 'FAILED':
+      return '执行失败';
+    case 'CANCEL':
+      return '已取消';
+    default:
+      return '状态未知';
+  }
+}
+
+export function taskTitle(task: ConversationTask): string {
+  return task.title?.trim() || task.agentName?.trim() || '未命名任务';
+}
+
+/** 仅构建开发模式可启用任务 fixture，生产产物不能通过 URL/localStorage 切为 mock。 */
+export function tasksMockEnabled(
+  isDevelopment: boolean,
+  flag?: string,
+): boolean {
+  return isDevelopment && flag === '1';
+}
+
+/** 图片仅允许浏览器安全的位图格式；HTML、SVG 等文件只可下载，不在任务面板执行。 */
+export function canPreviewTaskImage(resource: TaskArtifactResource): boolean {
+  return (
+    resource.kind === 'image' &&
+    /^image\/(png|jpeg|gif|webp)$/i.test(resource.blob.type)
+  );
+}
+
+/** 非法分页不可变成“已经全部加载”。 */
+export function assertTaskPage<T>(
+  page: TaskPage<T>,
+  previousCursor?: string,
+): void {
+  if (
+    !page ||
+    !Array.isArray(page.records) ||
+    typeof page.hasMore !== 'boolean' ||
+    (page.hasMore && (!page.nextCursor || page.nextCursor === previousCursor))
+  ) {
+    throw new TasksError('network', '任务数据格式异常，请重试');
+  }
+}
+
+export function mergeTaskRecords<T>(
+  previous: T[],
+  incoming: T[],
+  keyOf: (item: T) => string,
+): T[] {
+  const merged = new Map(previous.map((item) => [keyOf(item), item]));
+  incoming.forEach((item) => merged.set(keyOf(item), item));
+  return [...merged.values()];
+}
