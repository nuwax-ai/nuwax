+const task = (
+  conversationId: string,
+  key = conversationId,
+): ConversationTask => ({
+  key,
+  imConversationId: conversationId,
+  platformConversationId: `platform-${key}`,
+  agentSubjectId: 'agent-subject',
+  agentId: 'agent',
+  taskStatus: 'COMPLETE',
+});
+const page = (...records: ConversationTask[]): TaskPage<ConversationTask> => ({
+  records,
+  hasMore: false,
+});
+function deferred<T>() {
+  let resolve!: (value: T) => void;
+  let reject!: (error: unknown) => void;
+  const promise = new Promise<T>((yes, no) => {
+    resolve = yes;
+    reject = no;
+  });
+  return { promise, resolve, reject };
+}
+const settle = async () => {
+  await Promise.resolve();
+  await Promise.resolve();
+};
+function provider(
+  listTasks: ConversationTasksProvider['listTasks'],
+  extras: Partial<ConversationTasksProvider> = {},
+): ConversationTasksProvider {
+  return {
+    ...unavailableTasksProvider,
+    available: true,
+    mode: 'live',
+    listTasks,
+    ...extras,
+  };
+}
