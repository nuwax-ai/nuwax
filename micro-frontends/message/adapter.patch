+    [false, '1'],
+    [true, undefined],
+    [true, 'true'],
+    [true, '0'],
+  ] as const)
+    assert.equal(tasksMockEnabled(dev, flag), false);
+  assert.equal(unavailableTasksProvider.available, false);
+  const unavailable = (error: unknown) =>
+    error instanceof TasksError && error.code === 'unavailable';
+  await assert.rejects(
+    unavailableTasksProvider.listTasks({ imConversationId: '1001' }),
+    unavailable,
+  );
+  await assert.rejects(
+    unavailableTasksProvider.listArtifacts({
+      imConversationId: '1001',
+      taskKey: 't',
+    }),
+    unavailable,
+  );
+  await assert.rejects(
+    unavailableTasksProvider.readArtifact({
+      imConversationId: '1001',
+      taskKey: 't',
+      artifactId: 'a',
+    }),
+    unavailable,
+  );
+});
